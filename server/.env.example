# Copy to .env.local for `npm run migrate`, `npm run dev` and `npm run smoke`
# (or run `vercel env pull .env.local`). On Vercel, set these as Sensitive
# environment variables instead. Empty means unset. See README.md.

# Neon (added by the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 characters: openssl rand -base64 48
OWNER_KEY=
# Sent by Vercel Cron as "Authorization: Bearer ..."
CRON_SECRET=

# Vercel Blob (public store) for product photos
BLOB_READ_WRITE_TOKEN=

# Google Places API (New): live reviews, never stored
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJGz5HChRv3IARYJJy_6jyRm8
GOOGLE_DAILY_LIMIT=30

# Yelp Places API (paid; optional)
YELP_API_KEY=
YELP_BUSINESS_ID=izzy-clipz-barbershop-oceanside

# Stripe: Tap to Pay, saved cards and fees. Without STRIPE_CONNECT the key is the shop's
# own account. With STRIPE_CONNECT=on it's the app developer's Connect platform key, and the
# owner connects the shop's own account in the Business app (Settings → Connect Stripe).
STRIPE_SECRET_KEY=
STRIPE_CONNECT=
# Without STRIPE_CONNECT only: the shop's Terminal location (connect mode makes its own).
STRIPE_TERMINAL_LOCATION_ID=
# The webhook endpoint for events on your own account, and (connect mode) the platform's
# Connect endpoint for events on connected accounts. The webhook accepts either.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# The API's public https address (also the website's), for the pages Stripe Checkout and
# Stripe's onboarding send people back to. Required with STRIPE_CONNECT=on; otherwise
# optional (unset: the address requests come in on).
PUBLIC_BASE_URL=

# Optional
PG_POOL_MAX=5

# npm run smoke
SMOKE_BASE_URL=http://localhost:3000
SMOKE_OWNER_KEY=
