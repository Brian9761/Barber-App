# Copy to .env.local for `npm run migrate`, `npm run dev` and `npm run smoke`
# (or run `vercel env pull .env.local`). On Vercel, set these as Sensitive
# environment variables instead. Empty means unset. See README.md.

# Neon (added by the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 characters: openssl rand -base64 48
OWNER_KEY=
# Sent by Vercel Cron as "Authorization: Bearer ..."
CRON_SECRET=

# Vercel Blob (public store) for product photos
BLOB_READ_WRITE_TOKEN=

# Google Places API (New): live reviews, never stored
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJGz5HChRv3IARYJJy_6jyRm8
GOOGLE_DAILY_LIMIT=30

# Yelp Places API (paid; optional)
YELP_API_KEY=
YELP_BUSINESS_ID=izzy-clipz-barbershop-oceanside

# Stripe Terminal (Tap to Pay)
STRIPE_SECRET_KEY=
STRIPE_TERMINAL_LOCATION_ID=
STRIPE_WEBHOOK_SECRET=

# Optional
PG_POOL_MAX=5

# npm run smoke
SMOKE_BASE_URL=http://localhost:3000
SMOKE_OWNER_KEY=
