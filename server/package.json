{
  "name": "izzy-clipz-api",
  "version": "4.0.0",
  "private": true,
  "description": "Izzy Clipz booking, reviews, products and payments API (Vercel Functions + Neon Postgres).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "dev": "tsx scripts/dev.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.5",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
