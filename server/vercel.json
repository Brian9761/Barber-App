{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "public",
  "regions": ["pdx1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/business", "destination": "/business/index.html" },
    { "source": "/business/:path*", "destination": "/business/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms/", "destination": "/terms/index.html" },
    { "source": "/cancellation-policy", "destination": "/cancellation-policy/index.html" },
    { "source": "/cancellation-policy/", "destination": "/cancellation-policy/index.html" },
    { "source": "/accessibility", "destination": "/accessibility/index.html" },
    { "source": "/accessibility/", "destination": "/accessibility/index.html" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" },
        { "key": "x-frame-options", "value": "DENY" }
      ]
    }
  ],
  "crons": [{ "path": "/api/cron/daily", "schedule": "17 11 * * *" }]
}
